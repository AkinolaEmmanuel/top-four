# Base URL the Next.js rewrite proxy forwards /api/* to.
# Defaults to the staging API if unset.
API_TARGET_URL=https://api.topfour.app/v1

# Client-visible base URL for direct API calls that bypass the rewrite proxy.
# Either name works; NEXT_PUBLIC_API_URL takes precedence if both are set.
# Defaults to /api (same-origin, via the rewrite proxy above) if unset.
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_API_BASE_URL=

# Google OAuth 2.0 Web Client ID (from Google Cloud Console -> APIs & Services
# -> Credentials). Must match the backend's GOOGLE_OIDC_CLIENT_ID exactly --
# the backend verifies the ID token's audience against it. Without this set,
# the "Continue with Google" button on sign-in/sign-up simply doesn't render.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
