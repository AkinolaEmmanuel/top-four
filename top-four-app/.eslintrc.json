{
  "extends": ["next/core-web-vitals"],
  "rules": {
    "jsx-a11y/no-static-element-interactions": "error",
    "jsx-a11y/click-events-have-key-events": "error",
    "jsx-a11y/no-noninteractive-element-interactions": "error"
  },
  "overrides": [
    {
      "files": ["lib/api/generated/**"],
      "rules": {}
    }
  ],
  "ignorePatterns": [
    "lib/api/generated/**",
    ".next/**",
    "node_modules/**",
    "test-results/**",
    "playwright-report/**"
  ]
}
